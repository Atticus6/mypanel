#!/usr/bin/env bash
# mypanelctl — CLI management tool for mypanel (single-process master).
# Language is loaded from the file saved by install.sh.
set -euo pipefail

SERVICE="mypanel.service"
PREFIX="${MYPANEL_PREFIX:-/usr/local}"
CONF_DIR="$PREFIX/etc/mypanel"
CONF_LOCAL="$CONF_DIR/config.local.yaml"
INFO_FILE="$CONF_DIR/install-info"
UNIT_PATH="/etc/systemd/system/$SERVICE"
MASTER_BIN="$PREFIX/bin/master"

MYPANEL_CONF_DIR="$CONF_DIR"
I18N="$CONF_DIR/lib/i18n.sh"
if [ -f "$I18N" ]; then
    # shellcheck disable=SC1090
    source "$I18N"
    load_lang
else
    t() { printf '%s' "$1"; }
fi

log() { printf '\033[32m[mypanelctl]\033[0m %s\n' "$*"; }
warn() { printf '\033[33m[warn]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || die "$(t ctl_root_required "$1")"; }

get_conf_value() {
    local key="$1"
    grep -E "^${key}:" "$CONF_LOCAL" 2>/dev/null | tail -1 | sed -E 's/^[^:]*: *"?([^"]+)"?.*/\1/'
}

set_conf_value() {
    local key="$1" value="$2"
    [ -f "$CONF_LOCAL" ] || die "$(t ctl_no_conf "$CONF_LOCAL")"
    if grep -qE "^${key}:" "$CONF_LOCAL"; then
        sed -i -E "s|^${key}:.*|${key}: \"${value}\"|" "$CONF_LOCAL"
    else
        printf '%s: "%s"\n' "$key" "$value" >> "$CONF_LOCAL"
    fi
}

apply_ctl() {
    local action="$1" value="$2"
    need_root
    [ -x "$MASTER_BIN" ] || die "$(t ctl_no_master "$MASTER_BIN")"
    "$MASTER_BIN" -config "$CONF_DIR/config.yaml" -ctl-action "$action" -ctl-value "$value" >/dev/null 2>&1 \
        || die "$(t ctl_pwd_fail)"
}

restart_service() {
    need_root
    systemctl restart "$SERVICE"
    log "$(t ctl_restarted)"
}

show_info() {
    local addr port user data_dir entrance address local_ip
    addr="$(get_conf_value addr)"
    port="${addr#:}"
    user="$(get_conf_value admin_user)"
    data_dir="$(get_conf_value data_dir)"
    if [ -f "$INFO_FILE" ]; then
        entrance="$(grep -E '^entrance=' "$INFO_FILE" | tail -1 | cut -d= -f2-)"
        address="$(grep -E '^address=' "$INFO_FILE" | tail -1 | cut -d= -f2-)"
    fi
    [ -n "$entrance" ] || entrance="$(t not_set)"
    local_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    [ -n "$local_ip" ] || local_ip="<IP>"
    if [ -z "$address" ]; then
        address="http://$local_ip:$port"
        [ "$entrance" != "$(t not_set)" ] && address="$address/$entrance"
    fi

    echo
    echo "========== $(t info_title) =========="
    printf '  %-12s %s\n' "$(t visit_addr)" "$address"
    printf '  %-12s %s\n' "$(t port)" "$port"
    printf '  %-12s %s\n' "$(t account)" "$user"
    printf '  %-12s %s\n' "$(t data_dir)" "$data_dir"
    printf '  %-12s %s\n' "$(t entrance)" "/$entrance"
    echo "  --------------------------------"
    echo "  $(t no_password_shown)"
    echo "======================================"
    echo
}

cmd_status() {
    if systemctl is-active --quiet "$SERVICE" 2>/dev/null; then
        log "$(t service_running)"
    else
        log "$(t service_stopped)"
    fi
    systemctl status "$SERVICE" --no-pager 2>/dev/null | sed -n '1,8p' || true
    local addr
    addr="$(get_conf_value addr)"
    [ -n "$addr" ] && log "$(t listen_addr)$addr"
}

cmd_logs() {
    local follow="${1:-}"
    if [ "$follow" = "-f" ]; then
        journalctl -u "$SERVICE" -f
    else
        journalctl -u "$SERVICE" -n 200 --no-pager
    fi
}

cmd_version() {
    if [ -x "$MASTER_BIN" ]; then
        local v
        v="$(strings "$MASTER_BIN" | grep -m1 -oE '^v?[0-9]+\.[0-9]+\.[0-9]+$' || true)"
        log "$(t version)${v:-dev}"
    else
        die "$(t ctl_no_master "$MASTER_BIN")"
    fi
}

cmd_update() {
    local action="${1:-}" value="${2:-}"
    case "$action" in
        password)
            [ -n "$value" ] || die "$(t ctl_pwd_usage)"
            case "$value" in *' '*) die "$(t ctl_pwd_space)" ;; esac
            apply_ctl password "$value"
            set_conf_value admin_password "$value"
            chmod 600 "$CONF_LOCAL" 2>/dev/null || true
            if [ -f "$INFO_FILE" ]; then
                sed -i -E '/^password=/d' "$INFO_FILE" 2>/dev/null || true
            fi
            restart_service
            log "$(t ctl_pwd_set)"
            ;;
        port)
            [ -n "$value" ] || die "$(t ctl_port_usage)"
            case "$value" in ''|*[!0-9]*) die "$(t ctl_port_num)" ;; esac
            apply_ctl port "$value"
            set_conf_value addr ":$value"
            sed -i -E "s|^Environment=MYPANEL_ADDR=.*|Environment=MYPANEL_ADDR=:$value|" "$UNIT_PATH" 2>/dev/null || true
            if [ -f "$INFO_FILE" ]; then
                local_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
                [ -n "$local_ip" ] || local_ip="<IP>"
                local entrance="$(grep -E '^entrance=' "$INFO_FILE" | tail -1 | cut -d= -f2-)"
                sed -i -E "s|^address=.*|address=http://$local_ip:$value/$entrance|" "$INFO_FILE" 2>/dev/null || true
                sed -i -E "s|^port=.*|port=$value|" "$INFO_FILE" 2>/dev/null || true
            fi
            systemctl daemon-reload 2>/dev/null || true
            restart_service
            log "$(t ctl_port_set "$value")"
            ;;
        listen-ip)
            [ -n "$value" ] || die "$(t ctl_ip_usage)"
            apply_ctl listen-ip "$value"
            restart_service
            log "$(t ctl_ip_set "$value")"
            ;;
        entrance)
            [ -n "$value" ] || die "$(t ctl_entrance_usage)"
            local addr port
            addr="$(get_conf_value addr)"
            port="${addr#:}"
            apply_ctl entrance "$value"
            if [ -f "$INFO_FILE" ]; then
                local_ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
                [ -n "$local_ip" ] || local_ip="<IP>"
                if [ -n "$value" ]; then
                    sed -i -E "s|^entrance=.*|entrance=$value|" "$INFO_FILE" 2>/dev/null || true
                    sed -i -E "s|^address=.*|address=http://$local_ip:$port/$value|" "$INFO_FILE" 2>/dev/null || true
                else
                    sed -i -E 's|^entrance=.*|entrance=not-set|' "$INFO_FILE" 2>/dev/null || true
                    sed -i -E "s|^address=.*|address=http://$local_ip:$port|" "$INFO_FILE" 2>/dev/null || true
                fi
            fi
            restart_service
            log "$(t ctl_entrance_set "${value:-none}")"
            ;;
        *)
            die "$(t ctl_update_usage)"
            ;;
    esac
}

case "${1:-help}" in
    info) show_info ;;
    status) shift; cmd_status "$@" ;;
    start) need_root; systemctl start "$SERVICE"; log "$(t ctl_started)" ;;
    stop) need_root; systemctl stop "$SERVICE"; log "$(t ctl_stopped)" ;;
    restart) need_root; systemctl restart "$SERVICE"; log "$(t ctl_restarted)" ;;
    enable) need_root; systemctl enable "$SERVICE"; log "$(t ctl_enabled)" ;;
    disable) need_root; systemctl disable "$SERVICE"; log "$(t ctl_disabled)" ;;
    logs) shift; cmd_logs "$@" ;;
    version) cmd_version ;;
    update) shift; cmd_update "$@" ;;
    data-dir) log "$(t data_dir)$(get_conf_value data_dir)" ;;
    upgrade-source)
        shift
        if [ $# -eq 0 ]; then
            log "$(t ctl_upgrade)$(get_conf_value upgrade_repo_url)"
        else
            need_root
            set_conf_value upgrade_repo_url "$1"
            set_conf_value upgrade_resource_url "$1"
            restart_service
            log "$(t ctl_upgrade_set "$1")"
        fi
        ;;
    help|--help|-h)
        cat <<'EOF'
Usage: mypanelctl <command> [args]
  info                       Show install info (no password)
  status                     Show service status and address
  start|stop|restart         Manage the service
  enable|disable             Enable/disable at boot
  logs [-f]                  Show logs
  version                    Show version
  update password <new>      Reset admin password
  update port <port>         Change access port
  update listen-ip <addr>    Change listen address
  update entrance <code>     Change security entrance (empty to disable)
  data-dir                   Show data directory
  upgrade-source [URL]       Show/set upgrade source
  help                       Show this help
EOF
        ;;
    *) die "$(t ctl_unknown "$1")" ;;
esac
