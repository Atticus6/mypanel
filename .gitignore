.DS_Store
.bin/
bin/
node_modules/

# Build output synced here by scripts/build.sh; only the placeholder is tracked.
/master/internal/webdist/dist/*
!/master/internal/webdist/dist/.gitkeep
.zcode/

# 本地配置覆盖：config.yaml 入库作为默认值，个人改动放这里（不入库）。
config.local.yaml
data/

# 前端构建产物（由 scripts/build.sh 生成并复制到 embed 目录）。
/web/dist/

# 测试/运行时产生的临时数据目录与 SQLite 文件。
**/tmp/
*.db
*.db-wal
*.db-shm
*.db-journal
