{
    "name": "mypanel-web",
    "private": true,
    "version": "2.0",
    "description": "1Panel 前端",
    "type": "module",
    "scripts": {
        "dev": "vite --host",
        "serve": "vite",
        "build:dev": "vite build --mode development",
        "type-check": "bun check",
        "build:test": "bun run type-check && vite build --mode test",
        "build:pro": "vite build --mode production",
        "preview": "vite preview",
        "release": "standard-version",
        "fmt": "bun fmt --no-script src build oxc-plugin-jsx vite.config.ts",
        "fmt:check": "bun fmt --no-script --check src build oxc-plugin-jsx vite.config.ts",
        "build": "vite build --mode production",
        "test": "bun test"
    },
